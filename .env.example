# Plantilla de variables de entorno. Este archivo SI se versiona.
# Copialo a .env y rellena los valores reales. El .env nunca se versiona
# (Articulo IV.3 de la constitucion).

# Clave de firma de los JWT (HS256). Generala con un generador
# criptograficamente seguro, nunca a mano:
#   openssl rand -hex 32
SECRET_KEY=

# Cadena de conexion de la base de datos.
# Desarrollo (SQLite):  sqlite:///./pistas.db
# Produccion (Postgres): postgresql+psycopg://usuario:clave@host:5432/pistas
DATABASE_URL=

# Minutos de validez del token de acceso. Nunca infinito (Articulo IV.2).
ACCESS_TOKEN_EXPIRE_MINUTES=30
